{
  "name": "@seba174/ngx-loading-buttons",
  "version": "22.0.0",
  "description": "A lightweight Angular library to add a loading spinner to Angular Material buttons.",
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/cdk": "^22.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.schematics.json",
    "postbuild": "copyfiles schematics/*/schema.json schematics/*/files/** schematics/collection.json ../../dist/ngx-loading-buttons/"
  },
  "schematics": "./schematics/collection.json",
  "devDependencies": {
    "copyfiles": "file:../../node_modules/copyfiles",
    "typescript": "file:../../node_modules/typescript"
  },
  "ng-add": {
    "save": "dependencies"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seba174/ngx-loading-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/seba174/ngx-loading-buttons/issues"
  },
  "homepage": "https://github.com/seba174/ngx-loading-buttons#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./styles": "./src/styles.css",
    "./styles.css": "./src/styles.css"
  }
}
